# DEPLOY_TARGET: openshift
# BUILD_ARCH: arm64

# Stage 1: Build
FROM --platform=$BUILDPLATFORM registry.access.redhat.com/ubi9/nodejs-20:latest AS builder
WORKDIR /opt/app-root/src

COPY package*.json ./
COPY server/package*.json ./server/
COPY tsconfig.base.json ./

RUN npm ci --workspace=server

COPY server ./server

RUN npm run build --workspace=server

# Stage 2: Production runtime
FROM --platform=linux/amd64 registry.access.redhat.com/ubi9/nodejs-20-minimal:latest
WORKDIR /opt/app-root/src

ENV NODE_ENV=production
ENV PORT=8080
ENV HOST=0.0.0.0

COPY package*.json ./
COPY server/package*.json ./server/
RUN npm ci --workspace=server --omit=dev

COPY --from=builder /opt/app-root/src/server/dist ./server/dist

USER 1001
EXPOSE 8080

WORKDIR /opt/app-root/src/server
CMD ["node", "dist/index.js"]
