# DEPLOY_TARGET: openshift
# BUILD_ARCH: arm64

# Stage 1: Build
FROM --platform=$BUILDPLATFORM registry.access.redhat.com/ubi9/nodejs-22:latest AS builder
USER root
WORKDIR /opt/app-root/src

COPY --chown=1001:0 package*.json tsconfig.base.json ./
COPY --chown=1001:0 server/package*.json ./server/
COPY --chown=1001:0 server/tsconfig.json ./server/

RUN chown -R 1001:0 /opt/app-root && \
    chmod -R g+rwX /opt/app-root

USER 1001
RUN npm ci --workspace=server

USER root
COPY --chown=1001:0 server/src ./server/src
RUN chown -R 1001:0 /opt/app-root && \
    chmod -R g+rwX /opt/app-root

USER 1001
RUN npm run build --workspace=server

# Stage 2: Production runtime
FROM --platform=linux/amd64 registry.access.redhat.com/ubi9/nodejs-22-minimal:latest
USER root
WORKDIR /opt/app-root/src

ENV NODE_ENV=production
ENV PORT=8080
ENV HOST=0.0.0.0

COPY --chown=1001:0 package*.json ./
COPY --chown=1001:0 server/package*.json ./server/

RUN chown -R 1001:0 /opt/app-root && \
    chmod -R g+rwX /opt/app-root

USER 1001
RUN npm ci --workspace=server --omit=dev

USER root
COPY --chown=1001:0 --from=builder /opt/app-root/src/server/dist ./server/dist
RUN chown -R 1001:0 /opt/app-root && \
    chmod -R g+rwX /opt/app-root

USER 1001
EXPOSE 8080

WORKDIR /opt/app-root/src/server
CMD ["node", "dist/index.js"]
