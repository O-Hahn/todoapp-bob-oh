# Server Configuration
PORT=8080
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# External IBM Cloudant / Apache CouchDB Configuration
# Service URL and credentials must be provided via environment variables (never hardcoded)
CLOUDANT_URL=https://127.0.0.1:5984
# For IBM Cloudant IAM Authentication:
# CLOUDANT_APIKEY=your-ibm-cloud-iam-api-key
# For Basic Authentication (Apache CouchDB or Cloudant legacy):
CLOUDANT_USERNAME=admin
CLOUDANT_PASSWORD=password

# Database Names
DB_USERS=todo_users
DB_SESSIONS=todo_sessions
DB_API_TOKENS=todo_api_tokens
DB_TODOS=todo_todos

# Session & Security
# Generate a secure 32+ bytes random secret in hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
COOKIE_SECURE=false

# Administration
ADMIN_EMAIL=admin@example.com
KUBERNETES_NAMESPACE=todo-app
ADMIN_SECRET_NAME=todo-admin-initial
